# Copy to .env and fill in. This file ships inside the app bundle
# (see `flutter: assets:` in pubspec.yaml), so it must only ever contain
# values that are safe to expose in a distributed client.
#
# Keys listed here are the ones AppConfig actually reads
# (lib/core/config/app_config.dart). Anything else is ignored.

# API Configuration
API_BASE_URL=https://lms.tungabadranetworks.com/api

# Web app origin for Stripe/gateway return URLs (no /api). Falls back to
# stripping /api from API_BASE_URL when unset.
# CLIENT_ORIGIN=https://lms.tungabadranetworks.com

# Payment Gateway — publishable key only.
# RAZORPAY_KEY_SECRET belongs on the backend and must never appear here.
RAZORPAY_KEY_ID=rzp_test_example12345
